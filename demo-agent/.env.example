# ── OpenRouter ──────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── OpenBox Core ────────────────────────────────────────────────────────────
# Local stack: http://localhost:8086   Hosted: https://core.openbox.ai
OPENBOX_API_URL=http://localhost:8086
OPENBOX_API_KEY=obx_...
# Signed (AIP) mode — omit both to run unsigned.
OPENBOX_AGENT_DID=did:aip:...
OPENBOX_AGENT_PRIVATE_KEY=base64-ed25519-seed
